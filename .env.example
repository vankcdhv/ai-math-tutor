# Sao chép thành .env (đã gitignore) rồi thay giá trị: cp .env.example .env
# Sinh mật khẩu ngẫu nhiên: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=change-me-generate-a-random-value

# Tùy chọn: thư mục dữ liệu nóng (checkpoint, lake, kết quả lớn) trên ext4/SSD.
# Mặc định của config.py và scripts/in-wsl.sh là $HOME/nhom8-data.
# NHOM8_DATA_ROOT=/home/<user>/nhom8-data

# Dashboard: chế độ giáo viên (xem danh sách learner_id bế tắc) tắt mặc định; cần cả hai dòng.
# NHOM8_TEACHER_MODE=1
# TEACHER_PASSWORD=<sinh ngẫu nhiên như REDIS_PASSWORD>
# Xem một run thử (tiền tố khóa Redis của job --redis-key-prefix):
# NHOM8_DASHBOARD_KEY_PREFIX=
# Khóa API demo của dịch vụ gợi ý (≥ 16 ký tự): python3 -c "import secrets; print(secrets.token_urlsafe(24))"
NHOM8_HINT_API_KEY=change-me-generate-a-random-value